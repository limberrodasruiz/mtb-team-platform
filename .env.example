# ============================================================================
# MTB Team Platform — variables de entorno
# ============================================================================
# 1. Copia este archivo como .env en la raíz del proyecto.
# 2. Completa los valores con los de tu proyecto en Supabase:
#    Project Settings → API.
# 3. En Vercel, configura las mismas variables en
#    Project → Settings → Environment Variables.
#
# Vite solo expone al navegador las variables que empiezan con VITE_.
# ============================================================================

# URL base del proyecto. Ejemplo: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (o "publishable"). Puede estar en el navegador
# porque los permisos reales se aplican con RLS en PostgreSQL.
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ============================================================================
# SEGURIDAD
# ============================================================================
# - NUNCA agregues la clave service_role a este archivo, al frontend ni a una
#   variable con prefijo VITE_. Esa clave omite RLS y da acceso total.
# - No subas tu .env real a Git. Ya está excluido por .gitignore.
# - Si una clave privada se filtró, rótala de inmediato en Supabase.
# - El archivo .env.example no contiene credenciales reales.
